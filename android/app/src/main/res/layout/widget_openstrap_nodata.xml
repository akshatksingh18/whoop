<?xml version="1.0" encoding="utf-8"?><!--
  Shown when the app publishes has_data = false: the snapshot is empty, or it
  describes a day more than one behind. The rings layouts have nowhere to put a
  reason, and a stale readiness rendered at full confidence is the thing the
  phone's honesty contract exists to prevent — so this replaces them entirely.
  Text colours set at render time (theme_dark).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp">

    <TextView
        android:id="@+id/nodata_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No recent data"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/nodata_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Open OpenStrap and sync your strap."
        android:textSize="11sp"
        android:maxLines="2" />
</LinearLayout>
