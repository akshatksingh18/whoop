<?xml version="1.0" encoding="utf-8"?><!--
  Last-night widget metadata. Renders the app's published snapshot (never
  fetches); the 30-min re-render exists so the staleness flip can happen
  without the app running.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_sleep"
    android:previewLayout="@layout/widget_sleep"
    android:description="@string/widget_sleep_description"
    android:widgetCategory="home_screen|keyguard" />
