<?xml version="1.0" encoding="utf-8"?><!--
  The wide face: Recovery · Strain · Sleep across, the icon inside each dial and
  the number under it — the same trio, in the same order, as `RingTrio` on Home
  (lib/ui2/screens/home_screen.dart). Every string and every colour is set at
  render time; nothing here decides what a metric means.

  The last row is the absence: which ring is missing and the reason the pipeline
  gave for it, GONE when every ring is reporting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/dial_recovery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/cap_recovery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="1" />

            <TextView
                android:id="@+id/val_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp"
                android:textSize="17sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/sub_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/dial_strain"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/cap_strain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="1" />

            <TextView
                android:id="@+id/val_strain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp"
                android:textSize="17sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/sub_strain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/dial_sleep"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/cap_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="1" />

            <TextView
                android:id="@+id/val_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp"
                android:textSize="17sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/sub_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/gap_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="10sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
