<?xml version="1.0" encoding="utf-8"?><!--
  Overnight widget metadata (HRV + resting heart rate). Same push-driven
  snapshot as the metrics widget; the periodic re-render only ages it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_overnight"
    android:previewLayout="@layout/widget_overnight"
    android:description="@string/widget_overnight_description"
    android:widgetCategory="home_screen|keyguard" />
